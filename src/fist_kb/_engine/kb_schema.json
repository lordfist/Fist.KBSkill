{
  "format": "seed-kb-8-schema",
  "note": "The one authority for record kinds, fields, statuses and limits. Validation, error hints and tool descriptions read this file. origin describes where the content came from (who said or produced it, when, through which channel); created_by and the journal record who stored it.",
  "limits": {
    "title": 200,
    "statement": 3000,
    "text": 2000,
    "quote": 12000,
    "quote_view": 1500,
    "resolution_note": 1000,
    "log_text": 4000,
    "origin_value": 300,
    "option": 300,
    "options": 20,
    "ids": 50,
    "rules": 20,
    "topics": 20,
    "topic_name": 40
  },
  "core_limits": {
    "purpose": 600,
    "owner": 80,
    "pinned": 12,
    "routes": 40,
    "lead": 10,
    "about": 200
  },
  "field_types": {
    "title": "title",
    "statement": "statement",
    "topics": "topics",
    "related": "ids",
    "sources": "source_ids",
    "origin": "origin",
    "resolution": "resolution",
    "quote": "quote",
    "action": "text",
    "evidence": "text",
    "limits": "text",
    "claimant": "text",
    "basis": "ids",
    "applicability": "text",
    "options": "text_list",
    "step": "text",
    "next": "text",
    "stop": "text",
    "rules": "ids"
  },
  "replacing_ops": ["set", "remove", "restore", "status", "core"],
  "common_fields": ["title", "statement", "topics", "related", "sources", "origin", "resolution"],
  "required_fields": ["title", "statement"],
  "list_fields": ["topics", "related", "sources", "basis", "options", "rules"],
  "automatic_fields": ["id", "kind", "status", "created_at", "created_by", "updated_at", "created_rev", "updated_rev", "superseded_by", "supersedes"],
  "origin_types": ["owner_message", "observation", "source", "inference", "peer_message", "import"],
  "kinds": {
    "owner_decision": {"prefix": "DEC", "statuses": ["active", "superseded", "historical"], "default_status": "active", "fields": ["quote", "action", "applicability", "limits"]},
    "observed_fact": {"prefix": "FACT", "statuses": ["active", "disputed", "superseded", "historical"], "default_status": "active", "fields": ["evidence", "limits", "applicability", "action"]},
    "source_claim": {"prefix": "CLAIM", "statuses": ["active", "disputed", "superseded", "historical"], "default_status": "active", "fields": ["claimant", "evidence", "limits"]},
    "inference": {"prefix": "INF", "statuses": ["provisional", "active", "disputed", "superseded"], "default_status": "provisional", "fields": ["basis", "limits"]},
    "assumption": {"prefix": "ASM", "statuses": ["provisional", "active", "superseded"], "default_status": "provisional", "fields": ["limits"]},
    "recommendation": {"prefix": "REC", "statuses": ["active", "provisional", "superseded", "historical"], "default_status": "active", "fields": ["applicability", "action", "limits"]},
    "open_question": {"prefix": "Q", "statuses": ["open", "resolved", "historical"], "default_status": "open", "fields": ["options", "action", "limits"]},
    "task": {"prefix": "TASK", "statuses": ["active", "awaiting_owner", "blocked", "paused", "completed", "cancelled"], "default_status": "active", "fields": ["step", "next", "stop", "rules", "limits"]}
  },
  "view_priority": ["title", "status", "statement", "step", "next", "stop", "rules", "resolution", "action", "applicability", "quote", "evidence", "limits", "claimant", "basis", "options", "topics", "related", "sources", "superseded_by", "supersedes", "origin"],
  "kind_priority": ["task", "owner_decision", "recommendation", "observed_fact", "source_claim", "inference", "assumption", "open_question"],
  "search_weights": {"id": 12, "title": 8, "topics": 8, "statement": 6, "resolution": 6, "step": 5, "next": 5, "stop": 5, "action": 5, "applicability": 5, "quote": 4, "evidence": 3, "limits": 3, "log": 3, "history": 1}
}
