{
  "description": "Fist KB: add the selected project's KB core to context at session start, resume, /clear and after compaction. Windows only, like the MCP launcher; other platforms run a no-op.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "true",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'scripts\\session-context.ps1')\"",
            "timeout": 30,
            "statusMessage": "Loading Fist KB core"
          }
        ]
      }
    ]
  }
}
